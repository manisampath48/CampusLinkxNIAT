rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'manisampatharveti@gmail.com')
      );
    }

    // Authenticated Student Profile Avatars and Images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)'))
                    || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)'))
                    || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    match /profileImages/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)'))
                    || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Student Project and Showcase Images
    match /projects/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)'))
                    || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Student Hub Project Videos, Thumbnails, and Assets
    match /studentHub/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (request.auth != null
                    && request.resource.size < 100 * 1024 * 1024
                    && (request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/octet-stream')))
                    || isAdmin();
      allow delete: if (request.auth != null && (request.auth.uid == userId || isAdmin())) || isAdmin();
    }

    // Campus and Branding Assets
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /campuses/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
